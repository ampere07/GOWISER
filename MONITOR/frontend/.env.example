# The API's base URL, including the /api suffix — the client strips it only when
# fetching the Sanctum CSRF cookie from /sanctum/csrf-cookie.
#
# Baked in at build time, not read at runtime: changing it means rebuilding and
# redeploying, not editing a file on the server.
#
# Must match the backend's CORS_ALLOWED_ORIGINS from the other direction: this
# names the API the dashboard calls, that one names the dashboard the API accepts.
# A trailing slash or the wrong scheme fails the preflight, and every request then
# looks like a CORS fault rather than a configuration mistake.
REACT_APP_API_BASE_URL=https://backend3.gowiser.ph/api

# Seconds between silent dashboard refreshes. Keep at or above the backend's
# MONITOR_CACHE_TTL, or the extra polls only re-serve the same cached rollup.
REACT_APP_POLL_INTERVAL=30

# Local development:
# REACT_APP_API_BASE_URL=http://localhost:8000/api
