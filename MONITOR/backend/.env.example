APP_NAME="GOWISER Monitor"
APP_ENV=production
# Generate with `php artisan key:generate`. An empty value takes the whole app
# down — every request encrypts a cookie — so this is never optional.
# Use the SAME key everywhere that shares a database: the connection passwords in
# `site_connections` are encrypted with it.
APP_KEY=
# Debug must be false in production: the API deliberately passes driver messages
# through when it is on, and those name hosts, databases and tables.
APP_DEBUG=false
APP_URL=https://backend3.gowiser.ph

LOG_CHANNEL=stack
LOG_LEVEL=error

# ---------------------------------------------------------------------------
# MONITOR's own database
# ---------------------------------------------------------------------------
# The only database configured in this file, and the only one MONITOR writes to.
# Holds users, roles, the connection list, the audit trail and the palette.
#
# The databases being *reported on* are not here: they are added on the Databases
# page and stored in `site_connections` with the password encrypted at rest. That
# table is the single source of truth — see App\Services\SourceRegistry.
DB_CONNECTION=mysql
# localhost when deployed — MySQL runs on the same host as the API. Point this at
# the database server's address instead when developing against it from elsewhere.
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=monitor
DB_USERNAME=monitor
DB_PASSWORD=

# Seconds to cache each rollup, per database. Set to 0 while developing queries.
# Keep `reporting:warm`'s schedule below this, or it warms expired entries.
MONITOR_CACHE_TTL=60

# ---------------------------------------------------------------------------
# Session / CORS
# ---------------------------------------------------------------------------
# The dashboard and the API are different hosts on one parent domain:
#   exec.gowiser.ph      the dashboard
#   backend3.gowiser.ph  this API
#
# Scoping the cookies to the parent domain makes that pair same-site, so a
# SameSite=Lax cookie is still sent. A host-only cookie with SameSite=None would
# be a third-party cookie, which Safari restricts and Chrome is retiring.
#
# GOWISER can therefore see these cookies, so both names are namespaced. Leave
# them namespaced or the two apps overwrite each other's tokens.
SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_DOMAIN=.gowiser.ph
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE_COOKIE=lax
SESSION_COOKIE=monitor_session
SESSION_XSRF_COOKIE=monitor_xsrf

# Origin with scheme. Must match exactly — a trailing slash or the wrong scheme
# fails the preflight, and every request then looks like a CORS fault.
CORS_ALLOWED_ORIGINS=https://exec.gowiser.ph
# Host[:port] only, no scheme. A host missing here is treated as tokenless API
# traffic: login succeeds and every request after it 401s.
SANCTUM_STATEFUL_DOMAINS=exec.gowiser.ph

CACHE_DRIVER=file
QUEUE_CONNECTION=sync

# ---------------------------------------------------------------------------
# First admin account (read once by `php artisan db:seed`)
# ---------------------------------------------------------------------------
# Re-running the seeder with a new password updates the existing user, which is
# the only way to change it — MONITOR has no self-service password change.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@gowiser.ph
SEED_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Printed report letterhead
# ---------------------------------------------------------------------------
# Used by sources with no settings table of their own. NetManager has its own
# `settings` rows and those are read directly, ignoring these.
REPORT_COMPANY_NAME="GO WISER CORPORATION"
REPORT_COMPANY_DESC="Internet Service Provider"
REPORT_COMPANY_ADDRESS=
REPORT_COMPANY_TIN=
REPORT_COMPANY_MANAGER=
# A URL the browser can reach. Empty prints without a logo rather than leaving a
# broken-image icon on a document that gets signed.
REPORT_COMPANY_LOGO=

# ---------------------------------------------------------------------------
# Reporting performance
# ---------------------------------------------------------------------------
# Give up on a monitored database's TCP connect after this many seconds.
# Unbounded, one powered-off branch holds a request for over a minute.
REPORTING_CONNECT_TIMEOUT=5

# "All databases" queries every database. Each is handled by a short-lived child
# process so the network waits overlap instead of queueing. Set false to force
# the serial path — everything still works, just slower on a cold cache.
REPORTING_PARALLEL=true
# Keep at or below the core count; beyond that children compete for CPU rather
# than overlapping waits.
REPORTING_PARALLEL_PROCESSES=6
REPORTING_PARALLEL_MIN=2
REPORTING_PARALLEL_TIMEOUT=60
# Only if the web server's PHP is not the CLI PHP.
REPORTING_PARALLEL_PHP=

# Pre-computes the sections so the first viewer does not pay for a full fan-out.
# Scheduled every minute in App\Console\Kernel, which needs the cron entry:
#   * * * * * cd /path/to/backend && php artisan schedule:run >> /dev/null 2>&1
REPORTING_WARM=true

# ---------------------------------------------------------------------------
# Local development
# ---------------------------------------------------------------------------
# Replace the four values above with these to run against a local frontend.
# SESSION_SECURE_COOKIE=true drops the cookie over plain HTTP, so login fails
# silently without this.
# APP_ENV=local
# APP_DEBUG=true
# APP_URL=http://localhost:8000
# SESSION_DOMAIN=
# SESSION_SECURE_COOKIE=false
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
