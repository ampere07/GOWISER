APP_NAME="GOWISER Monitor"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# MONITOR's own database
# ---------------------------------------------------------------------------
# Holds only this app's users, roles, palette and sessions. Create it first:
#   CREATE DATABASE monitor CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=monitor
DB_USERNAME=root
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Monitored sources (read-only)
# ---------------------------------------------------------------------------
# One block per database being reported on. Use a SELECT-only MySQL user:
#
#   CREATE USER 'monitor_ro'@'%' IDENTIFIED BY 'strong-password-here';
#   GRANT SELECT ON gowiser.* TO 'monitor_ro'@'%';
#   FLUSH PRIVILEGES;
#
DB_GOWISER_HOST=127.0.0.1
DB_GOWISER_PORT=3306
DB_GOWISER_DATABASE=gowiser
DB_GOWISER_USERNAME=monitor_ro
DB_GOWISER_PASSWORD=

DB_NETMANAGER_HOST=127.0.0.1
DB_NETMANAGER_PORT=3306
DB_NETMANAGER_DATABASE=netmanager
DB_NETMANAGER_USERNAME=monitor_ro
DB_NETMANAGER_PASSWORD=

# Which sources appear in the portal's source switcher.
MONITOR_SOURCE_GOWISER_ENABLED=true
MONITOR_SOURCE_NETMANAGER_ENABLED=true
MONITOR_DEFAULT_SOURCE=netmanager

# Seconds to cache each rollup. Set to 0 while developing queries.
MONITOR_CACHE_TTL=60
MONITOR_QUERY_TIMEOUT=15

# ---------------------------------------------------------------------------
# Session / CORS
# ---------------------------------------------------------------------------
# The portal authenticates with a cookie session, so the frontend origin must
# be listed here and in SANCTUM_STATEFUL_DOMAINS or login will appear to work
# and then every subsequent request will 401.
SESSION_DRIVER=file
SESSION_LIFETIME=480
# Leave SESSION_DOMAIN empty so the cookie is host-only. Setting it to a shared
# parent domain (.gowiser.ph) would make MONITOR and GOWISER overwrite each
# other's XSRF-TOKEN, and logging into one would break the other.
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE_COOKIE=lax
# Explicit so it can never collide with GOWISER's session cookie.
SESSION_COOKIE=monitor_session

CORS_ALLOWED_ORIGINS=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# ---------------------------------------------------------------------------
# First admin account (used once by `php artisan db:seed`)
# ---------------------------------------------------------------------------
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@gowiser.ph
SEED_ADMIN_PASSWORD=
